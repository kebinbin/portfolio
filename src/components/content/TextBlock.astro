---
const { title, class: passedClass = '' } = Astro.props
---

<div class={`text-block flex flex-col gap-4 xl:flex-row xl:gap-32 ${passedClass}`}>
	<div class="w-full xl:max-w-[360px] xl:min-w-[360px]">
		<div aria-hidden="true" class="eyebrow text-ink/45 mb-4 flex items-center gap-3">
			<span class="text-block-index text-ink font-semibold"></span>
			<span class="bg-ink/25 h-px w-8"></span>
		</div>
		<h2
			class="text-ink text-[clamp(1.5rem,2.2vw,2.25rem)] leading-[1.1] font-medium tracking-tight text-pretty"
		>
			{title}
		</h2>
	</div>
	<div class="project-prose w-full min-w-0"><slot /></div>
</div>
