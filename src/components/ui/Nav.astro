---
import Icon from '../icons/Icon.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
import NavMenuItems from './NavMenuItems.astro'
import NavMenuFooter from './NavMenuFooter.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: t('nav.projects'), href: `/${lang}/#projects` },
	// { label: t('nav.experience'), href: `/${lang}/#experience` },
	// { label: t('nav.workflow'), href: `/${lang}/#workflow` },
	{ label: t('nav.about'), href: `/${lang}/#about` },
	{ label: t('nav.contact'), href: `/${lang}/#contact` }
]
---

<nav
	class="text-ink/55 relative z-50 container py-6 text-xs tracking-[0.2em] uppercase sm:py-12 sm:text-sm lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-6"
>
	<div
		class="flex justify-between gap-2 lg:col-span-5 lg:col-start-1 lg:row-start-1 lg:p-0 xl:col-span-6 2xl:col-span-7"
	>
		<a href=`/${lang}/` class="tracking-[0.28em]">
			<span>{`${t('nav.brand.full.first')} ${t('nav.brand.full.middle')}`}</span>
			<span class="text-ink font-semibold">{t('nav.brand.full.last')}</span>
		</a>
		<menu-button class="flex items-center">
			<template>
				<button
					class="hover:text-ink focus-visible:text-ink aria-expanded:text-ink/40 relative flex border-0 p-0 text-2xl transition-colors [&[hidden]]:hidden"
					aria-expanded="false"
				>
					<span class="sr-only">Menu</span>
					<Icon name="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<div
		class="absolute inset-x-0 lg:static lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:flex lg:items-center xl:col-span-4 xl:col-start-9"
	>
		<noscript>
			<div class="lg:flex lg:w-full lg:items-center lg:justify-end lg:gap-x-8 2xl:justify-between">
				<NavMenuItems links={textLinks} />
				<NavMenuFooter noScript />
			</div>
		</noscript>
	</div>
	<div
		id="menu-content-js"
		class="absolute inset-x-0 lg:col-span-5 lg:col-start-8 lg:row-start-1 xl:col-span-4 xl:col-start-9 lg:[&.js-enabled]:static lg:[&.js-enabled]:flex lg:[&.js-enabled]:items-center lg:[&.js-enabled]:justify-end lg:[&.js-enabled]:gap-x-8 2xl:[&.js-enabled]:justify-between"
		hidden
	>
		<NavMenuItems links={textLinks} />
		<NavMenuFooter />
	</div>

	<!--
		Full-bleed bottom rule, same tier/color as the hero baseline lines.
		Width set via an arbitrary property (not `border-b`) — Tailwind v4's
		border-width utilities also set border-*-style via --tw-border-style
		(defaults solid), which at the `lg:` breakpoint lands later in the
		cascade than grid-line's plain `border-style: dashed` and silently
		overrides just this side back to solid. The arbitrary property only
		touches width, leaving grid-line's dashed style intact.
	-->
	<span
		aria-hidden="true"
		class="grid-line absolute bottom-0 left-1/2 h-0 w-screen -translate-x-1/2 border-b"></span>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super()

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true))
			const btn = this.querySelector('button')!

			// Hide menu (shown by default to support no-JS browsers).
			const menuContent = document.getElementById('menu-content-js')!
			menuContent.hidden = true
			// Add "js-enabled" class in JS to avoid covering content in non-JS browsers.
			menuContent.classList.add('js-enabled')

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false')
				menuContent.hidden = !expand
			}

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menuContent.hidden))

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches)
				btn.hidden = e.matches
			}
			const mediaQueries = window.matchMedia('(min-width: 1024px)')
			handleViewports(mediaQueries)
			mediaQueries.addEventListener('change', handleViewports)
		}
	}
	customElements.define('menu-button', MenuButton)
</script>
