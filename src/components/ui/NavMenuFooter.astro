---
import ThemeToggle from './ThemeToggle.astro'
import LanguagePicker from './LanguagePicker.astro'

interface Props {
	noScript?: boolean
}

const { noScript = false } = Astro.props
---

<div class="relative left-1/2 w-dvw max-w-none -translate-x-1/2 lg:contents">
	<div class="bg-surface border-ink/25 border-y border-solid py-6 lg:contents">
		<div class="container flex justify-between gap-3 lg:items-center lg:justify-end lg:px-0">
			<LanguagePicker />
			{
				!noScript && (
					<div class="flex items-center">
						<ThemeToggle />
					</div>
				)
			}
		</div>
	</div>
</div>
