---
import { languages } from '../../i18n/ui'
const { currentLocale } = Astro
const [lang] = Object.keys(languages).filter((lang) => lang != currentLocale)
---

<a
	class="hover:text-retro-navy dark:hover:text-retro-bone focus:text-stone-950 lg:px-1 dark:text-stone-500 dark:focus:text-stone-200"
	href={`/${lang}/`}>{lang}</a
>
