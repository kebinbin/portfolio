---
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
import Icon from '../icons/Icon.astro'
import type { IconName } from '../icons/icons'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const currentYear = new Date().getFullYear()
const socialLinks: { icon: IconName; label: string; href: string }[] = [
	{ icon: 'github-filled', label: t('footer.github'), href: 'https://github.com/kebinbin' },
	{
		icon: 'linkedin-filled',
		label: t('footer.linkedin'),
		href: 'https://linkedin.com/in/kevin-castillo-santiago'
	}
]
---

<footer>
	<span aria-hidden="true" class="grid-line bleed-x block h-0 border-t"></span>
	<div class="container flex flex-wrap-reverse items-center justify-between gap-y-3 py-8">
		<p class="eyebrow text-ink/45">&copy; {currentYear} Kevin Castillo</p>
		<ul class="m-0 flex list-none flex-wrap gap-8">
			{
				socialLinks.map((link) => (
					<li>
						<a
							class="eyebrow text-ink/60 hover:text-ink focus-visible:text-ink flex items-center gap-2 transition-colors"
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon name={link.icon} class="size-3.5" />
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
