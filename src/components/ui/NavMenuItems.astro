---
interface Link {
	//Factor these types for reuse.
	label: string
	href: string
}
interface Props {
	links: Link[]
}

const { links } = Astro.props

//Check how to consider forced-colors: active
---

<ul
	class="bg-surface m-0 flex list-none flex-col gap-5 p-6 sm:gap-7 lg:flex-row lg:bg-transparent lg:p-0"
>
	{
		links.map(({ label, href }) => (
			<li>
				<a
					aria-current={Astro.url.pathname === href}
					class="hover:text-ink focus-visible:text-ink aria-[current=true]:text-ink inline-block transition-colors"
					href={href}
				>
					{label}
				</a>
			</li>
		))
	}
</ul>
