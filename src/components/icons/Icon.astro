---
import { Icon as Iconify } from 'astro-icon/components'
import { icons, type IconName } from './icons'

interface Props {
	name: IconName
	class?: string
	/** Accessible label. When omitted the icon is decorative (aria-hidden). */
	label?: string
}

const { name, class: className, label } = Astro.props
const def = icons[name]

// Default to 1em so bare <Icon name="list" /> matches surrounding text size.
const cls = className ?? 'size-[1em]'
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }
---

{
	def.source === 'iconify' ? (
		<Iconify name={def.id} class={cls} {...a11y} />
	) : def.source === 'phosphor' ? (
		<svg
			viewBox="0 0 256 256"
			class={cls}
			fill="currentColor"
			stroke="currentColor"
			stroke-width="6"
			{...a11y}
			set:html={def.body}
		/>
	) : (
		<svg viewBox={def.viewBox} class={cls} fill="currentColor" {...a11y} set:html={def.body} />
	)
}
