---
import Layout from '../../../layouts/Layout.astro'
import CTA from '../home/sections/CTA.astro'

const { project } = Astro.props
const { slug } = project
const [, projectSlug] = slug.split('/')
---

<Layout
	title={`${project.data.title} — Kevin Castillo`}
	description={project.data.description}
	image={project.data.img}
	imageAlt={project.data.img_alt}
	type="article"
>
	<header class="container py-6">
		<!--
			Header on the 12-col page-grid. H1 full-width on top; below it the meta
			(period · role + type) on cols 1–4 and the description on cols 5–12 —
			4 / 8, no blank column between. The 4-col meta gives the inline
			period · role room to sit on one line. Typography of the meta is the
			original treatment (eyebrow period·role, light tagline). Stacks to one
			column below lg.
		-->
		<div class="page-grid items-start gap-y-8 lg:gap-y-12">
			<div class="col-span-12 leading-none">
				<h1
					transition:name={`${projectSlug}-title`}
					class="tracking-tightest -ml-1 text-[clamp(3.5rem,16vw,12rem)] leading-[0.9] font-medium lg:-ml-2"
				>
					{project.data.title}
				</h1>
			</div>
			<div class="col-span-12 lg:col-span-4 lg:pr-12">
				<div class="eyebrow text-ink/45 flex flex-wrap items-center gap-2.5">
					<span transition:name={`${projectSlug}-period`} class="text-ink font-semibold">
						{project.data.period}
					</span>
					<span aria-hidden="true" class="bg-ink/25 h-px w-6"></span>
					<span>{project.data.role}</span>
				</div>
				<p
					transition:name={`${projectSlug}-type`}
					class="text-ink mt-3 text-2xl font-light tracking-tight text-pretty capitalize lg:text-3xl"
				>
					{project.data.type}
				</p>
			</div>
			<div class="col-span-12 lg:col-span-8 lg:col-start-5 lg:pt-1">
				<p class="text-ink/70 text-base leading-7 text-pretty lg:text-lg">
					{project.data.description}
				</p>
			</div>
		</div>
		<div
			transition:name={`${projectSlug}-hero-img`}
			class="border-ink/7 outline-ink/15 dark:border-ink/5 dark:outline-ink/8 mx-auto mt-12 w-full overflow-hidden rounded-[.5rem] border-5 shadow-xl outline-1 md:rounded-[1rem] md:border-6 xl:mt-24 xl:rounded-[1.5rem] xl:border-7"
		>
			<img
				src={project.data.img}
				alt={project.data.img_alt || ''}
				loading="lazy"
				decoding="async"
			/>
		</div>
	</header>
	<main class="case-study container flex flex-col gap-10 py-8 xl:gap-20 xl:py-16">
		<slot />
	</main>
	<CTA />
</Layout>
