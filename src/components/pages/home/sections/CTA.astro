---
import { getI18N } from '../../../../i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home
const { h2, paragraph } = i18n.contact
const { email } = i18n.metadata
---

<aside class="container flex min-h-[calc(100svh-5rem)] flex-col items-center justify-center">
	<div class="flex h-full flex-col items-center justify-center gap-20 text-center lg:gap-26">
		<a id="contact"
			><h2 class="text-ink text-headline-lg">
				<span class="block font-light">{h2['1']}</span>
				<span class="block font-semibold">{h2['2']}<span class="text-accent">.</span></span>
			</h2></a
		>
		<p class="text-ink/60 text-sm leading-7 lg:text-base">
			{paragraph}
			<a
				href={`mailto:${email}`}
				class="text-accent hover:text-accent-strong font-medium transition-colors"
			>
				{email}
			</a>
		</p>
	</div>
</aside>
