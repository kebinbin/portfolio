---
import { getI18N } from '../../../../i18n'
import { getLangFromUrl } from '../../../../i18n/utils'
import { getImageSize } from '../../../content/imageSize'

const lang = getLangFromUrl(Astro.url)
const { currentLocale } = Astro
const { bio, education, services, h2, eyebrow, cta, portrait, technologies } = getI18N({
	currentLocale
}).home.about

const portraitImg = '/assets/kevin-castillo-portrait.webp'
// The aspect-[3/4] class already reserves this box, so these attributes are
// belt-and-braces rather than a CLS fix — they keep the intrinsic ratio correct
// if the stylesheet is ever slow or the class changes.
const portraitSize = getImageSize(portraitImg)

// Skills and Technologies merge under one "Skills" heading (services.h3
// already reads "Skills") instead of two separately labeled lists.
const skillsAndTech = [...services.list, ...technologies.list]

// H2 baseline as a fraction of --text-headline — same constant Projects.astro
// uses, so the rule lands on the type's feet.
const H2_BASELINE = 0.835
---

{
	/*
	DOM order follows the mobile reading order (intro → portrait → what I do →
	beyond the screen → skills → education → résumé) — Skills sits before
	Education below lg. Each child carries its own lg:col-start/row-start so
	the desktop composition (portrait/education/résumé left, everything else
	right, Education above Skills' row) comes from grid placement alone —
	nothing is duplicated or hidden per breakpoint.

	Portrait spans two row tracks (row-span-2) instead of pinning to row 1
	alone: row 1 on its own would only be as tall as the short intro paragraph
	beside it, and pinning the portrait there would force that whole row to
	the portrait's height, stranding "What I do" a few hundred pixels below
	the intro. Spanning rows 1–2 lets the portrait's height settle across the
	combined space of the intro AND "What I do" rows instead.

	Below lg, the intro sits full-width right under the H2 (sm:row-start-1
	alone), then portrait and the What I do/Beyond the screen stack share
	row 2 side by side, 3 cols each — What I do and Beyond the screen stack
	on top of each other within their column rather than splitting into two
	more columns. At lg the composition changes entirely: intro moves beside
	the portrait, What I do/Beyond the screen split into their own row.

	Items sharing a row always carry an explicit row-start at that tier: grid
	items with a definite column but no row placement each claim their own
	new row, even when their columns don't overlap — without the shared
	row-start they'd stack instead of sitting side by side.
	*/
}
<section class="container pt-20 lg:pt-32">
	<header class="relative">
		<a id="about"
			><h2 class="text-headline text-ink">
				{h2}<span class="text-accent ml-1">.</span>
			</h2></a
		>
		<span
			aria-hidden="true"
			class="grid-line absolute left-1/2 hidden h-0 w-screen -translate-x-1/2 border-t lg:block"
			style={`top: calc(var(--text-headline) * ${H2_BASELINE})`}></span>
		<p
			aria-hidden="true"
			class="text-ink/50 absolute right-0 hidden text-[10px] tracking-[0.25em] uppercase 2xl:block"
			style={`top: calc(var(--text-headline) * ${H2_BASELINE}); transform: translateY(-0.4em)`}
		>
			{eyebrow}
		</p>
	</header>

	<div class="page-grid mt-12 items-start gap-y-10 lg:mt-16">
		<p
			class="text-ink col-span-6 text-2xl leading-tight font-medium tracking-tight text-pretty sm:row-start-1 lg:col-span-8 lg:col-start-5 lg:row-start-1 lg:text-3xl"
		>
			{bio.intro}
		</p>

		<div
			class="col-span-6 sm:col-span-3 sm:col-start-1 sm:row-start-2 lg:col-span-3 lg:col-start-1 lg:row-span-2 lg:row-start-1"
		>
			<img
				src={portraitImg}
				alt={portrait.img_alt}
				width={portraitSize?.width}
				height={portraitSize?.height}
				loading="lazy"
				decoding="async"
				class="aspect-[3/4] w-full object-cover object-top"
			/>
			<p class="eyebrow text-ink/45 mt-3">{portrait.eyebrow}</p>
		</div>

		<div
			class="page-grid col-span-6 gap-y-8 sm:col-span-3 sm:col-start-4 sm:row-start-2 lg:col-span-8 lg:col-start-5 lg:row-start-2"
		>
			<div class="col-span-6">
				<h3 class="eyebrow text-ink/45">{bio.career.h3}</h3>
				<p class="text-ink/70 mt-3 text-sm leading-7 text-pretty">{bio.career.p}</p>
			</div>
			<div class="col-span-6">
				<h3 class="eyebrow text-ink/45">{bio.extra.h3}</h3>
				<p class="text-ink/70 mt-3 text-sm leading-7 text-pretty">{bio.extra.p}</p>
			</div>
		</div>

		<div class="col-span-6 lg:col-span-8 lg:col-start-5 lg:row-start-3">
			<h3 class="eyebrow text-ink/45">{services.h3}</h3>
			<ul class="mt-3 columns-2 gap-x-6 sm:columns-3 lg:columns-4">
				{
					skillsAndTech.map((item) => (
						<li class="text-ink/70 break-inside-avoid text-sm leading-relaxed break-words">
							{item}
						</li>
					))
				}
			</ul>
		</div>

		<div class="col-span-6 lg:col-span-3 lg:col-start-1 lg:row-start-3">
			<h3 class="eyebrow text-ink/45">{education.h3}</h3>
			{
				education.list.map((edu) => (
					<div class="mt-3">
						<p class="text-ink text-sm font-medium">{edu.college}</p>
						<p class="text-ink/60 text-sm">
							{edu.degree} · {edu.dates}
						</p>
					</div>
				))
			}
		</div>

		<div class="col-span-6 lg:col-span-3 lg:col-start-1 lg:row-start-4">
			<p class="text-ink/55 text-sm">{cta.question}</p>
			<a
				href={`/assets/resume/${lang}/resume-kevin.castillo.pdf`}
				class="eyebrow text-accent hover:text-accent-strong mt-2 inline-block font-semibold transition-colors"
			>
				{cta.link} →
			</a>
		</div>
	</div>
</section>
