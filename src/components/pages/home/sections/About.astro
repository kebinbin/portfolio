---
import { getI18N } from '../../../../i18n'
import { getLangFromUrl } from '../../../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home
const { bio, education, services, h2, cta, portrait, technologies } = i18n.about

const portraitImg = '/assets/kevin-castillo-portrait.webp'
---

<section class="container pt-20 lg:pt-32">
	<!--
		Header, three distinct compositions by breakpoint:
		- below sm: everything stacks full-width (col-span-6) in source order.
		- sm–lg (tablet): H2 on its own full-width row on top; intro paragraph
		  (left) + portrait (right) as two top-aligned columns below.
		- lg (desktop, 1024+): H2 + intro paragraph together on the left columns
		  (explicit row-start-1 / row-start-2 stacks intro directly under H2 in
		  the same column range), portrait row-spans both rows on the right,
		  self-end so it bottom-aligns with the intro paragraph like the original
		  desktop layout.
		H2 needs an explicit col-span-6 (not bare col-span-12) — on the 6-col
		grid a 12-span child forces 6 implicit tracks, which shrinks the
		explicit tracks the sibling intro/portrait spans rely on.
	-->
	<header class="page-grid items-start gap-y-10 lg:gap-y-12">
		<a id="about" class="col-span-6 block lg:col-span-8 lg:row-start-1"
			><h2 class="text-headline text-ink">
				<span class="font-light tracking-tighter">{h2['1']}</span>
				<span class="font-semibold">{h2['2']}</span>
				<span class="font-light tracking-tighter"
					>{h2['3']}<span class="text-accent ml-2">.</span></span
				>
			</h2></a
		>
		<p
			class="text-ink col-span-6 text-2xl leading-tight font-medium tracking-tight sm:col-span-3 lg:col-span-8 lg:row-start-2 lg:max-w-[40ch] lg:text-3xl"
		>
			{bio.intro}
		</p>
		<div
			class="col-span-6 sm:col-span-3 sm:col-start-4 lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:self-end"
		>
			<img
				data-portrait-img
				src={portraitImg}
				alt={portrait.img_alt}
				loading="lazy"
				decoding="async"
				class="aspect-[3/4] w-full object-cover object-top"
			/>
			<p class="eyebrow text-ink/45 mt-3">{portrait.eyebrow}</p>
		</div>
	</header>

	<div class="page-grid mt-12 items-start gap-y-10">
		<div class="col-span-6 sm:col-span-3 lg:col-span-3">
			<h3 class="eyebrow text-ink/45 block">{bio.career.h3}</h3>
			<p class="text-ink/70 mt-3 text-sm leading-7 text-pretty">{bio.career.p}</p>
		</div>
		<div class="col-span-6 sm:col-span-3 sm:col-start-4 lg:col-span-3 lg:col-start-5">
			<h3 class="eyebrow text-ink/45 block">{bio.extra.h3}</h3>
			<p class="text-ink/70 mt-3 text-sm leading-7 text-pretty">{bio.extra.p}</p>
		</div>
		<div class="col-span-6 lg:col-span-4 lg:col-start-9">
			<h3 class="eyebrow text-ink/45 block">{education.h3}</h3>
			{
				education.list.map((edu) => (
					<div class="mt-3">
						<p class="text-ink text-sm font-medium">{edu.college}</p>
						<p class="text-ink/60 text-sm">
							{edu.degree} · {edu.dates}
						</p>
					</div>
				))
			}
			<h3 class="eyebrow text-ink/45 mt-6 block">{services.h3}</h3>
			<ul class="mt-3 flex flex-col gap-1">
				{services.list.map((s) => <li class="text-ink/70 text-sm leading-snug">{s}</li>)}
			</ul>
		</div>
	</div>
	<div class="mt-8 flex items-baseline gap-2">
		<span class="text-ink/55 text-sm">{cta.question}</span>
		<a
			href={`/assets/resume/${lang}/resume-kevin.castillo.pdf`}
			class="eyebrow text-accent hover:text-accent-strong font-semibold transition-colors"
		>
			{cta.link} →
		</a>
	</div>
</section>
