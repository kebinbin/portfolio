---
import { getLangFromUrl } from '../../../../i18n/utils'
import { getI18N } from '../../../../i18n'
const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home
const lang = getLangFromUrl(Astro.url)
---

<header
	class="relative container flex min-h-[calc(100svh-7.25rem)] flex-col pt-8 pb-10 sm:pt-12 sm:pb-14"
>
	<!-- Grid with Plotted text blocks — left edges ON the vertical grid lines -->
	<div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden md:block">
		<span class="bg-retro-navy/10 absolute inset-y-0 left-1/4 w-px"></span>
		<span class="bg-retro-navy/10 absolute inset-y-0 left-2/4 w-px"></span>
		<span class="bg-retro-navy/10 absolute inset-y-0 left-3/4 w-px"></span>
		<span class="bg-retro-navy/10 absolute inset-x-0 top-1/3 h-px"></span>
		<span class="bg-retro-navy/10 absolute inset-x-0 top-2/3 h-px"></span>
	</div>
	<p
		aria-hidden="true"
		class="text-retro-navy/80 absolute top-[13%] left-1/4 hidden flex-col text-xs font-medium tracking-[0.25em] uppercase md:flex"
	>
		<span>Software</span>
		<span>Engineer</span>
	</p>
	<p
		aria-hidden="true"
		class="text-retro-navy/50 absolute top-1/3 left-3/4 hidden flex-col pt-3 text-[10px] tracking-[0.25em] uppercase md:flex"
	>
		<span>kevincastillo.io</span>
	</p>
	<p
		aria-hidden="true"
		class="text-retro-navy/50 absolute top-2/3 left-2/4 hidden flex-col pt-3 text-[10px] tracking-[0.25em] uppercase md:flex"
	>
		<span>Puerto Rico</span>
		<span>GMT-4</span>
	</p>
	<!-- End of grid lines -->

	<h1
		aria-label={`${i18n.hero.h1['1']} ${i18n.hero.h1['2']} ${i18n.hero.h1['3']}`}
		class="text-retro-navy flex grow flex-col justify-center py-6 font-medium"
	>
		<span aria-hidden="true" class="tracking-tightest block text-[14rem] leading-[0.75]"
			>{i18n.hero.h1['1']}</span
		>
		<span aria-hidden="true" class="tracking-tightest block text-[14rem] leading-[0.75]"
			>{i18n.hero.h1['2']}</span
		>
		<span aria-hidden="true" class="tracking-tightest block text-[14rem] leading-[0.75]"
			>{i18n.hero.h1['3']}</span
		>
	</h1>
	<!-- Bottom band -->
	<div class="border-retro-navy/25 grid grid-cols-12 gap-x-8 gap-y-6 border-t pt-5">
		<p
			class="text-retro-navy/70 col-span-12 max-w-[54ch] text-sm leading-6 sm:col-span-6 sm:text-base"
		>
			{i18n.hero.p}
		</p>
		<dl
			class="col-span-12 grid grid-cols-1 gap-x-6 gap-y-5 self-start sm:col-span-6 sm:col-start-7 sm:grid-cols-3 sm:gap-y-0"
		>
			{
				i18n.hero.meta.map((item) => (
					<div class="flex flex-col gap-1.5">
						<dt class="text-retro-navy/55 text-[10px] tracking-[0.2em] uppercase sm:text-xs">
							{item.label}
						</dt>
						<dd class="text-retro-navy text-sm leading-snug">{item.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
	<!-- Availability + jump link -->
	<aside class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6">
		<p class="text-retro-navy/80 flex items-center gap-2.5 text-sm font-medium">
			<span class="bg-retro-green size-2.5 rounded-full"></span>
			{i18n.hero.aside.availableFor}
		</p>
		<a
			href={`/${lang}/#work`}
			class="text-retro-rust hover:text-retro-brown text-xs font-medium tracking-[0.08em] uppercase"
			>{i18n.hero.cta.work}&nbsp;&nbsp;↓</a
		>
	</aside>
</header>
