---
import { existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { getCollection } from 'astro:content'
import { getI18N } from '../../../../i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home

// Content Fetching: list work projects, newest first
const projects = (await getCollection('projects'))
	.filter((project) => {
		return project.slug.split('/')[0] === currentLocale
	})
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

// Mirrors content/Image.astro: an uncaptured card image renders a labeled
// placeholder instead of a broken <img>, since this card is rendered directly
// (not through the Image content component).
function imageExists(src: string) {
	return existsSync(fileURLToPath(new URL(`../../../../../public${src}`, import.meta.url)))
}
---

<section class="pt-24 lg:pt-24">
	<header class="container flex flex-col">
		<a id="projects"
			><h2 class="text-headline text-ink xs:pb-8 pb-4">
				{i18n.projects.h2}<span class="text-accent ml-4">.</span>
			</h2></a
		>
	</header>
	<ul>
		{
			projects.map((project, index) => {
				const { data, slug } = project
				const [, projectSlug] = slug.split('/')
				const imageLeft = index % 2 === 0
				const number = String(index + 1).padStart(2, '0')
				return (
					<li class="container">
						<article class="page-grid items-center gap-y-6 py-12 xl:gap-y-0 xl:py-18">
							<div
								class={`col-span-6 grid grid-cols-6 gap-x-6 gap-y-6 lg:col-span-12 xl:col-span-3 xl:row-start-1 xl:pt-1 ${imageLeft ? 'xl:col-start-10' : 'xl:col-start-1'}`}
							>
								<div class="col-span-6 lg:col-span-2 xl:col-span-6">
									<span class="eyebrow text-ink/45 flex items-center gap-2.5">
										<span class="text-ink font-semibold">{number}</span>
										<span aria-hidden="true" class="bg-ink/25 h-px w-6" />
										<span transition:name={`${projectSlug}-period`}>{data.period}</span>
									</span>
									<a href={`projects/${projectSlug}`} class="mt-2 block xl:mt-4">
										<h3
											transition:name={`${projectSlug}-title`}
											class="text-ink tracking-display text-[clamp(2.5rem,4vw,3.75rem)] leading-[0.95] font-medium"
										>
											{data.title}
										</h3>
									</a>
									<span
										transition:name={`${projectSlug}-type`}
										class="text-ink/70 mt-1 block text-xl tracking-tight capitalize xl:mt-3"
									>
										{data.type}
									</span>
								</div>
								<div class="col-span-6 lg:col-span-4 xl:col-span-6">
									<p class="text-ink/70 text-sm leading-6 text-pretty">{data.description}</p>
									<a
										href={`projects/${projectSlug}`}
										class="eyebrow text-accent hover:text-accent-strong mt-8 hidden w-fit items-center gap-2 font-semibold transition-colors xl:flex"
									>
										{i18n.projects.cta} →
									</a>
								</div>
							</div>
							<a
								href={`projects/${projectSlug}`}
								class={`col-span-6 block lg:col-span-12 xl:col-span-8 xl:row-start-1 ${imageLeft ? 'xl:col-start-1' : 'xl:col-start-5'}`}
							>
								<div
									transition:name={`${projectSlug}-hero-img`}
									class="border-ink/7 outline-ink/15 dark:border-ink/5 dark:outline-ink/8 overflow-hidden rounded-[.5rem] border-5 shadow-xl outline-1 md:rounded-[1rem] md:border-6 xl:rounded-[1.5rem] xl:border-7"
								>
									{imageExists(data.img) ? (
										<img
											src={data.img}
											alt={data.img_alt || ''}
											loading={index === 0 ? 'eager' : 'lazy'}
											decoding="async"
											class="aspect-video size-full object-cover"
										/>
									) : (
										<div class="bg-ink/5 text-ink/40 flex aspect-video w-full flex-col items-center justify-center gap-2 p-8 text-center">
											<span class="text-xs font-semibold tracking-wide uppercase">
												Card image placeholder
											</span>
											<span class="text-ink/60 max-w-md text-sm text-pretty">{data.img_alt}</span>
										</div>
									)}
								</div>
							</a>
							<a
								href={`projects/${projectSlug}`}
								class="eyebrow text-accent hover:text-accent-strong col-span-6 ml-auto flex w-fit items-center gap-2 font-semibold transition-colors lg:col-span-12 lg:mt-4 xl:hidden"
							>
								{i18n.projects.cta} →
							</a>
						</article>
					</li>
				)
			})
		}
	</ul>
</section>
