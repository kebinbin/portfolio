---
import { getCollection } from 'astro:content'
import { getI18N } from '../../../../i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home

// Content Fetching: List four most recent work projects
const projects = (await getCollection('projects'))
	.filter((project) => {
		return project.slug.split('/')[0] === currentLocale
	})
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
// .slice(0, 2)

// const gridSpan = [8, 4, 4, 8]
// const gridSpan = [7, 5, 5, 7]
---

<section class="py-24 lg:container lg:py-32">
	<header>
		<a id="projects"
			><h2 class="text-retro-navy tracking-tightest text-start text-9xl leading-[0.9] font-medium">
				{i18n.projects.h2}
			</h2></a
		>
	</header>
	<ul class="border-retro-navy/25 mt-14 flex flex-col border-b">
		{
			projects.map((project, index) => {
				const { data, slug } = project
				const [, projectSlug] = slug.split('/')
				const imageLeft = index % 2 === 0
				return (
					<li class="border-retro-navy/25 border-t py-10 sm:py-14">
						<article class="page-grid items-start">
							<div
								class={`border-retro-navy/25 col-span-12 overflow-hidden border sm:col-span-7 ${!imageLeft ? 'sm:order-last' : ''}`}
							>
								<img
									transition:name={`${projectSlug}-hero-img`}
									src={data.img}
									alt={data.img_alt || ''}
									loading={index === 0 ? 'eager' : 'lazy'}
									decoding="async"
									class="aspect-video size-full object-cover"
								/>
							</div>

							<div
								class={`col-span-12 flex flex-col sm:col-span-5 sm:pt-2 ${!imageLeft ? 'sm:order-first' : ''}`}
							>
								<span class="text-retro-navy/50 text-xs tracking-[0.2em] uppercase sm:text-sm">
									{String(index + 1).padStart(2, '0')} —
									<span transition:name={`${projectSlug}-period`}>{data.period}</span>
								</span>
								<span
									transition:name={`${projectSlug}-title`}
									class="tracking-display text-retro-navy group-hover:text-retro-rust mt-2 block text-4xl leading-[0.95] font-medium capitalize transition-colors sm:text-5xl"
								>
									{data.title}
								</span>
								<span
									transition:name={`${projectSlug}-type`}
									class="text-retro-navy/70 mt-2 block text-sm capitalize"
								>
									{data.type}
								</span>
								<span class="text-retro-navy/70 mt-4 block max-w-[44ch] text-sm leading-6">
									{data.description}
								</span>
								<a
									href={`projects/${projectSlug}`}
									class="text-retro-rust group-hover:text-retro-brown mt-5 inline-block text-xs tracking-[0.15em] uppercase sm:text-sm"
								>
									View case study →
								</a>
							</div>
						</article>
					</li>
				)
			})
		}
	</ul>
</section>
