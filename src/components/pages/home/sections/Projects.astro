---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import { getCollection } from 'astro:content'
import { getI18N } from '../../../../i18n'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale }).home

// Content Fetching: list work projects, newest first
const projects = (await getCollection('projects'))
	.filter((project) => {
		return project.slug.split('/')[0] === currentLocale
	})
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

// Mirrors content/Image.astro: an uncaptured card image renders a labeled
// placeholder instead of a broken <img>, since this card is rendered directly
// (not through the Image content component).
function imageExists(src: string) {
	return existsSync(join(process.cwd(), 'public', src))
}
---

<section class="pt-24 lg:pt-24">
	<header class="container flex flex-col">
		<a id="projects"
			><h2 class="text-headline text-ink">
				{i18n.projects.h2}<span class="text-accent ml-4">.</span>
			</h2></a
		>
	</header>
	<ul>
		{
			projects.map((project, index) => {
				const { data, slug } = project
				const [, projectSlug] = slug.split('/')
				const imageLeft = index % 2 === 0
				const number = String(index + 1).padStart(2, '0')
				return (
					<li class="block">
						<article class="page-grid container items-center gap-y-6 py-12 lg:gap-y-0 lg:py-18">
							<a
								href={`projects/${projectSlug}`}
								class={`col-span-12 block ${imageLeft ? 'lg:col-span-8' : 'lg:col-span-8 lg:col-start-5'}`}
							>
								<div
									transition:name={`${projectSlug}-hero-img`}
									class="border-ink/7 outline-ink/15 dark:border-ink/5 dark:outline-ink/8 overflow-hidden rounded-[.5rem] border-5 shadow-xl outline-1 md:rounded-[1rem] md:border-6 xl:rounded-[1.5rem] xl:border-7"
								>
									{imageExists(data.img) ? (
										<img
											src={data.img}
											alt={data.img_alt || ''}
											loading={index === 0 ? 'eager' : 'lazy'}
											decoding="async"
											class="aspect-video size-full object-cover"
										/>
									) : (
										<div class="bg-ink/5 text-ink/40 flex aspect-video w-full flex-col items-center justify-center gap-2 p-8 text-center">
											<span class="text-xs font-semibold tracking-wide uppercase">
												Card image placeholder
											</span>
											<span class="text-ink/60 max-w-md text-sm text-pretty">{data.img_alt}</span>
										</div>
									)}
								</div>
							</a>

							<div
								class={`col-span-12 flex flex-col lg:pt-1 ${imageLeft ? 'lg:col-span-3 lg:col-start-10' : 'lg:col-span-3 lg:col-start-1 lg:row-start-1'}`}
							>
								<span class="eyebrow text-ink/45 flex items-center gap-2.5">
									<span class="text-ink font-semibold">{number}</span>
									<span aria-hidden="true" class="bg-ink/25 h-px w-6" />
									<span transition:name={`${projectSlug}-period`}>{data.period}</span>
								</span>
								<a href={`projects/${projectSlug}`} class="mt-4 block">
									<h3
										transition:name={`${projectSlug}-title`}
										class="text-ink tracking-display text-[clamp(2.5rem,4vw,3.75rem)] leading-[0.95] font-medium"
									>
										{data.title}
									</h3>
								</a>
								<span
									transition:name={`${projectSlug}-type`}
									class="text-ink/70 mt-3 block text-lg tracking-tight capitalize"
								>
									{data.type}
								</span>
								<p class="text-ink/70 mt-6 max-w-[40ch] text-sm leading-6">{data.description}</p>
								<a
									href={`projects/${projectSlug}`}
									class="eyebrow text-accent hover:text-accent-strong mt-8 inline-flex items-center gap-2 font-semibold transition-colors"
								>
									{i18n.projects.cta} →
								</a>
							</div>
						</article>
					</li>
				)
			})
		}
	</ul>
</section>
