---
import MainHead from '../components/layouts/MainHead.astro'
import Nav from '../components/ui/Nav.astro'
import Footer from '../components/ui/Footer.astro'
import { getLangFromUrl } from '../i18n/utils'
import { ClientRouter } from 'astro:transitions'

interface Props {
	title?: string | undefined
	description?: string | undefined
}

const { title, description } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<html lang={lang} class="scroll-smooth">
	<head>
		<MainHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body class="font-body bg-surface text-ink min-h-full overflow-x-clip antialiased">
		<!--
			Page-wide vertical raster (DESIGN.md §2.2): the 12 columns + their gaps
			= 24 hairlines are identical on every section, so they live here once,
			`fixed` behind all content (`-z-10`: above the body background, below
			in-flow content). Built from the same `container` + `page-grid` classes
			every section uses, so the lines align to all page content. Horizontal
			rules stay per-section/component.
		-->
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
			<div class="page-grid container h-full grid-rows-1">
				{
					/* Reveal exactly one cell per column so cell count == column count
					   at each breakpoint (1 / 6 / 12), matching page-grid — otherwise
					   the extra cells wrap into phantom rows. */
					Array.from({ length: 12 }).map((_, i) => (
						<span
							class:list={[
								'grid-line border-x',
								i === 0 ? '' : i < 6 ? 'hidden sm:block' : 'hidden lg:block'
							]}
						/>
					))
				}
			</div>
		</div>
		<Nav />
		<slot />
		<Footer />
		<script>
			document.addEventListener('astro:after-swap', () =>
				document
					.querySelectorAll('video')
					.forEach((v) => v.closest('[data-astro-transition-persist]') || (v.src = v.src))
			)
		</script>
	</body>
</html>
